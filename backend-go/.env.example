# 拾财 PennyPick 后端环境变量配置模板
# 使用方法：复制本文件为 .env 并按需修改（cp .env.example .env）
# 全部变量均有默认值，不配置也能直接运行

# 项目名称（启动日志显示）
PROJECT_NAME=拾财 PennyPick

# 后端监听端口
PORT=8003

# JWT 签名密钥（生产环境务必修改为强随机值）
SECRET_KEY=please-change-me-to-a-random-secret

# SQLite 数据库文件路径
DATABASE_URL=sqlite:///./pennypick.db

# 初始管理员账号（仅首次启动建库时生效）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123
INIT_ADMIN_NICKNAME=主人
